#!/usr/bin/env python3
"""tdad-fullstack CLI entry point.

Thin wrapper that delegates to tdad.cli with multi-language extensions loaded.
This file is what `npx skills add ZhenSiRong/tdad-fullstack` symlinks into PATH.
"""
import sys
from pathlib import Path

# Ensure src/ is on sys.path when invoked as a script
_HERE = Path(__file__).resolve().parent
_SRC = _HERE.parent / "src"
if str(_SRC) not in sys.path:
    sys.path.insert(0, str(_SRC))

from tdad.cli import main  # noqa: E402

if __name__ == "__main__":
    main(sys.argv[1:])
